<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Safe example configuration. Contains placeholders only.

	  To enable the real ElevenLabs voice agent:

	  1. Copy this file to:  PointPilot/Config/ElevenLabs.plist
	     (that path is gitignored, so your real IDs are never committed)

	  2. Replace YOUR_AGENT_ID_HERE with your public ElevenLabs agent ID.

	  3. Add the ElevenLabs Swift SDK package in Xcode:
	     File ▸ Add Package Dependencies…
	     https://github.com/elevenlabs/elevenlabs-swift-sdk.git  (2.0.0+)

	  With no plist present, the app runs the full flow through the local mock
	  voice service and typed input. Nothing breaks and nothing is disabled.
	-->
	<key>AgentID</key>
	<string>YOUR_AGENT_ID_HERE</string>
	<key>UserID</key>
	<string>YOUR_END_USER_ID_HERE</string>
</dict>
</plist>
