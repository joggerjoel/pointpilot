# PointPilot Environment Variables
# Copy this file to the REPOSITORY ROOT as `.env` and replace with your keys.
# The root `.env` is the single source of truth: a `Bundle .env` pre-build
# script copies the keys below into the app bundle, because an iOS app cannot
# read files outside its own container at runtime.
#
# Only these keys are copied in (see the script's whitelist):
#   YELP_API_KEY, YELP_TOKEN, ELEVENLABS_AGENT_ID
# Anything else in .env stays out of the binary — including an ElevenLabs API
# key, which is a server-side secret and must never ship in an app.
# NEVER commit real secrets!

# Yelp Fusion API Key (from https://www.yelp.com/developers/v3/manage_app)
YELP_API_KEY=YOUR_YELP_API_KEY_HERE

# Optional ElevenLabs Agent ID (a PUBLIC agent ID, never an API key)
ELEVENLABS_AGENT_ID=YOUR_ELEVENLABS_AGENT_ID_HERE
