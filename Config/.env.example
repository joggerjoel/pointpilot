# PointPilot Environment Variables
# Copy this file to .env or Config/PointPilot.env and replace with your actual keys.
# NEVER commit .env or files containing real secrets!

# Yelp Fusion API Key (from https://www.yelp.com/developers/v3/manage_app)
YELP_API_KEY=YOUR_YELP_API_KEY_HERE

# Optional ElevenLabs Agent ID
ELEVENLABS_AGENT_ID=YOUR_ELEVENLABS_AGENT_ID_HERE
